# Backend Configuration
PORT=3000

# MQTT Broker Configuration
MQTT_BROKER=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

# MQTT Topics (must match ESP32 config)
TOPIC_TEMPERATURE=iot/sensor/temperature
TOPIC_HUMIDITY=iot/sensor/humidity
TOPIC_AIR_QUALITY=iot/sensor/airquality
TOPIC_STATUS=iot/device/status

# Database
DB_FILE=./iot_data.db


#Chatbot Configuration
CHAT_DB_FILE=./chat_history.db

LLM_API_URL=your_llm_api_endpoint_here
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=your-llm-model-name